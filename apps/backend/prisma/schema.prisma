datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TaskStatus {
  to_do
  pending
  in_progress
  done
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  status      TaskStatus  @default(to_do)
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  auditLogs   AuditLog[]

  @@index([deletedAt])
  @@index([status])
  @@map("tasks")
}

model AuditLog {
  id          String      @id @default(uuid())
  taskId      String
  taskTitle   String
  actor       String
  fromStatus  TaskStatus
  toStatus    TaskStatus
  createdAt   DateTime    @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("audit_logs")
}
